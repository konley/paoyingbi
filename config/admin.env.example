# Copy outside the repository and load it through systemd EnvironmentFile.
# Generate both values with admin_server/bootstrap_secrets.py.
ADMIN_PASSWORD_HASH=argon2id-hash-generated-at-deploy-time
ADMIN_SESSION_SECRET=random-secret-generated-at-deploy-time
ADMIN_PUBLIC_ORIGIN=https://example.com
ADMIN_ALLOWED_HOSTS=example.com,www.example.com
